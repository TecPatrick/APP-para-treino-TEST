{
  "collections": {
    "users": {
      "documents": {
        "{userId}": {
          "collections": {
            "favorite_foods": {
              "documents": {
                "{foodId}": {
                  "fields": {
                    "foodId": "number",
                    "foodName": "string",
                    "category": "string",
                    "isFavorite": "boolean",
                    "updatedAt": "timestamp"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
