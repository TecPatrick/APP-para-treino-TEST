rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Helpers ---

    function isValidUserProfile(data) {
      return data.userId == request.auth.uid &&
             data.email is string &&
             (!('name' in data) || data.name is string) &&
             (!('age' in data) || data.age is int) &&
             (!('weightKg' in data) || data.weightKg is number) &&
             (!('heightCm' in data) || data.heightCm is number) &&
             (!('hasCompletedOnboarding' in data) || data.hasCompletedOnboarding is bool);
    }

    function isValidWorkoutLog(data) {
      return data.userId == request.auth.uid &&
             data.dateMillis is int &&
             (!('durationMinutes' in data) || data.durationMinutes is int);
    }

    function isValidCardioLog(data) {
      return data.userId == request.auth.uid &&
             data.dateMillis is int &&
             data.type is string;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
                       isValidUserProfile(request.resource.data) &&
                       request.resource.data.createdAt <= request.time;
      allow update: if isOwner(userId) && 
                       isValidUserProfile(request.resource.data) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);

      match /workout_logs/{logId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && 
                         isValidWorkoutLog(request.resource.data) &&
                         request.resource.data.createdAt <= request.time;
        allow update: if isOwner(userId) && 
                         isValidWorkoutLog(request.resource.data) &&
                         request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /cardio_logs/{logId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && 
                         isValidCardioLog(request.resource.data) &&
                         request.resource.data.createdAt <= request.time;
        allow update: if isOwner(userId) && 
                         isValidCardioLog(request.resource.data) &&
                         request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }
    }
  }
}
