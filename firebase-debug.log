[debug] [2026-10-22T23:37:00.297Z] >>> [apiv2][body] PUT http://127.0.0.1:8085/emulator/v1/projects/demo-growth-diet:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\n// Assumed data model:\n// All documents are private and scoped below /users/{authenticated uid}.\n// users stores profile and nutrition targets.\n// calorieGoals stores nutrition targets.\n// workoutLogs and gpsRouteLogs store exercise metrics.\n// mealPlans, shoppingItems and progressLogs store diet/progress records.\n// All models require userId and a server-generated updatedAt timestamp.\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n\n    function uidUnchanged(data, userId) {\n      return data.userId is string && data.userId == userId;\n    }\n\n    function uidNotModified(data, userId) {\n      return uidUnchanged(data, userId) &&\n             (!('userId' in resource.data) || data.userId == resource.data.userId);\n    }\n\n    function validText(value, maxSize) {\n      return value is string && value.size() <= maxSize;\n    }\n\n    function validNumber(value, minimum, maximum) {\n      return value is number && value >= minimum && value <= maximum;\n    }\n\n    function validUpdatedAt(data) {\n      // Every client write must use FieldValue.serverTimestamp(). This prevents\n      // forged future timestamps from winning synchronization conflicts.\n      return data.updatedAt is timestamp;\n    }\n\n    function validEmail(value) {\n      return validText(value, 254) &&\n             value.matches('^[^@]+@[^@]+[.][^@]+$');\n    }\n\n    function authenticatedEmailMatches(value) {\n      return 'email' in request.auth.token &&\n             request.auth.token.email is string &&\n             value == request.auth.token.email;\n    }\n\n    function isValidUser(data, userId) {\n      let fields = [\n        'userId', 'name', 'email', 'gender', 'age', 'weightKg', 'heightCm',\n        'biotype', 'trainingDaysPerWeek', 'activityLevel', 'goal',\n        'targetCalories', 'targetProteinGrams', 'targetCarbsGrams',\n        'targetFatGrams', 'targetWaterMl', 'monthlyTargetWeightKg',\n        'monthlyTargetDurationWeeks', 'monthlyNotes', 'updatedAt'\n      ];\n      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) &&\n             uidUnchanged(data, userId) &&\n             validText(data.name, 100) && validEmail(data.email) &&\n             authenticatedEmailMatches(data.email) &&\n             data.gender in ['MASCULINO', 'FEMININO'] &&\n             validNumber(data.age, 1, 120) &&\n             validNumber(data.weightKg, 20, 500) &&\n             validNumber(data.heightCm, 50, 300) &&\n             data.biotype in ['ECTOMORPH', 'MESOMORPH', 'ENDOMORPH'] &&\n             validNumber(data.trainingDaysPerWeek, 0, 7) &&\n             data.activityLevel in ['SEDENTARY', 'LIGHT', 'MODERATE', 'VERY_ACTIVE', 'EXTRA_ACTIVE'] &&\n             data.goal in ['BULKING_CLEAN', 'BULKING_AGGRESSIVE', 'MAINTENANCE', 'CUTTING_MODERATE', 'CUTTING_AGGRESSIVE'] &&\n             validNumber(data.targetCalories, 500, 10000) &&\n             validNumber(data.targetProteinGrams, 0, 1000) &&\n             validNumber(data.targetCarbsGrams, 0, 2000) &&\n             validNumber(data.targetFatGrams, 0, 1000) &&\n             validNumber(data.targetWaterMl, 0, 20000) &&\n             validNumber(data.monthlyTargetWeightKg, 20, 500) &&\n             validNumber(data.monthlyTargetDurationWeeks, 1, 104) &&\n             validText(data.monthlyNotes, 2000) && validUpdatedAt(data);\n    }\n\n    function isValidCalorieGoal(data, userId) {\n      let fields = ['userId', 'targetCalories', 'targetProteinGrams', 'targetCarbsGrams', 'targetFatGrams', 'targetWaterMl', 'updatedAt'];\n      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) &&\n             uidUnchanged(data, userId) &&\n             validNumber(data.targetCalories, 500, 10000) &&\n             validNumber(data.targetProteinGrams, 0, 1000) &&\n             validNumber(data.targetCarbsGrams, 0, 2000) &&\n             validNumber(data.targetFatGrams, 0, 1000) &&\n             validNumber(data.targetWaterMl, 0, 20000) && validUpdatedAt(data);\n    }\n\n    function isValidWorkout(data, userId) {\n      let fields = ['userId', 'routineId', 'routineName', 'dateMillis', 'durationMinutes', 'totalVolumeKg', 'totalSetsCompleted', 'perceivedExertion', 'notes', 'updatedAt'];\n      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) &&\n             uidUnchanged(data, userId) &&\n             validNumber(data.routineId, 0, 9999999999999) &&\n             validText(data.routineName, 150) &&\n             validNumber(data.dateMillis, 0, 9999999999999) &&\n             validNumber(data.durationMinutes, 0, 10000) &&\n             validNumber(data.totalVolumeKg, 0, 100000000) &&\n             validNumber(data.totalSetsCompleted, 0, 10000) &&\n             validNumber(data.perceivedExertion, 0, 10) &&\n             validText(data.notes, 5000) && validUpdatedAt(data);\n    }\n\n    function isValidGpsRoute(data, userId) {\n      let fields = ['userId', 'routeName', 'activityType', 'dateMillis', 'dateDisplay', 'durationSeconds', 'distanceMeters', 'stepsCount', 'caloriesBurned', 'averagePaceMinPerKm', 'routePointsJson', 'notes', 'updatedAt'];\n      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) &&\n             uidUnchanged(data, userId) &&\n             validText(data.routeName, 150) && validText(data.activityType, 50) &&\n             validNumber(data.dateMillis, 0, 9999999999999) &&\n             validText(data.dateDisplay, 100) &&\n             validNumber(data.durationSeconds, 0, 10000000) &&\n             validNumber(data.distanceMeters, 0, 10000000) &&\n             validNumber(data.stepsCount, 0, 100000000) &&\n             validNumber(data.caloriesBurned, 0, 1000000) &&\n             validNumber(data.averagePaceMinPerKm, 0, 10000) &&\n             validText(data.routePointsJson, 500000) &&\n             validText(data.notes, 5000) && validUpdatedAt(data);\n    }\n\n    function isValidMeal(data, userId) {\n      let fields = ['userId', 'mealType', 'name', 'portionGrams', 'calories', 'protein', 'carbs', 'fat', 'isCompletedToday', 'isFixed', 'updatedAt'];\n      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) &&\n             uidUnchanged(data, userId) &&\n             validText(data.mealType, 50) && validText(data.name, 200) &&\n             validNumber(data.portionGrams, 0, 100000) &&\n             validNumber(data.calories, 0, 100000) &&\n             validNumber(data.protein, 0, 10000) &&\n             validNumber(data.carbs, 0, 10000) &&\n             validNumber(data.fat, 0, 10000) &&\n             data.isCompletedToday is bool &&\n             data.isFixed is bool && validUpdatedAt(data);\n    }\n\n    function isValidShoppingItem(data, userId) {\n      let fields = ['userId', 'name', 'category', 'totalQuantityGrams', 'unit', 'estimatedPrice', 'isBought', 'updatedAt'];\n      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) &&\n             uidUnchanged(data, userId) &&\n             validText(data.name, 200) && validText(data.category, 50) &&\n             validText(data.unit, 20) &&\n             validNumber(data.totalQuantityGrams, 0, 1000000) &&\n             validNumber(data.estimatedPrice, 0, 10000000) &&\n             data.isBought is bool && validUpdatedAt(data);\n    }\n\n    function isValidProgress(data, userId) {\n      let fields = ['userId', 'dateMillis', 'weightKg', 'bodyFatPercent', 'notes', 'updatedAt'];\n      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) &&\n             uidUnchanged(data, userId) &&\n             validNumber(data.dateMillis, 0, 9999999999999) &&\n             validNumber(data.weightKg, 20, 500) &&\n             validNumber(data.bodyFatPercent, 0, 100) &&\n             validText(data.notes, 5000) && validUpdatedAt(data);\n    }\n\n    function isValidFoodRecord(data, userId) {\n      let fields = ['userId', 'dateString', 'dateMillis', 'mealType', 'foodItemId', 'foodName', 'amount', 'unit', 'calories', 'protein', 'carbs', 'fat', 'fiber', 'notes', 'updatedAt'];\n      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) && uidUnchanged(data, userId) &&\n             validText(data.dateString, 10) && validNumber(data.dateMillis, 0, 9999999999999) &&\n             validText(data.mealType, 50) && validNumber(data.foodItemId, 0, 9999999999999) &&\n             validText(data.foodName, 200) && validNumber(data.amount, 0, 100000) && validText(data.unit, 20) &&\n             validNumber(data.calories, 0, 100000) && validNumber(data.protein, 0, 10000) &&\n             validNumber(data.carbs, 0, 10000) && validNumber(data.fat, 0, 10000) &&\n             validNumber(data.fiber, 0, 10000) && validText(data.notes, 5000) && validUpdatedAt(data);\n    }\n\n    function isValidCardio(data, userId) {\n      let fields = ['userId', 'type', 'durationMinutes', 'caloriesBurned', 'distanceKm', 'dateMillis', 'notes', 'updatedAt'];\n      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) && uidUnchanged(data, userId) &&\n             validText(data.type, 50) && validNumber(data.durationMinutes, 0, 10000) &&\n             validNumber(data.caloriesBurned, 0, 1000000) && validNumber(data.distanceKm, 0, 1000000) &&\n             validNumber(data.dateMillis, 0, 9999999999999) && validText(data.notes, 5000) && validUpdatedAt(data);\n    }\n\n    function isValidDailyIntake(data, userId) {\n      let fields = ['userId', 'dateString', 'dateMillis', 'totalCalories', 'totalProtein', 'totalCarbs', 'totalFat', 'targetCalories', 'isAdhered', 'waterDrankMl', 'updatedAt'];\n      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) && uidUnchanged(data, userId) &&\n             validText(data.dateString, 10) && validNumber(data.dateMillis, 0, 9999999999999) &&\n             validNumber(data.totalCalories, 0, 100000) && validNumber(data.totalProtein, 0, 10000) &&\n             validNumber(data.totalCarbs, 0, 10000) && validNumber(data.totalFat, 0, 10000) &&\n             validNumber(data.targetCalories, 500, 10000) && data.isAdhered is bool &&\n             validNumber(data.waterDrankMl, 0, 20000) && validUpdatedAt(data);\n    }\n\n    function isValidFavoriteFood(data, userId) {\n      let fields = ['userId', 'foodId', 'foodName', 'category', 'isFavorite', 'updatedAt'];\n      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) && uidUnchanged(data, userId) &&\n             validNumber(data.foodId, 0, 9999999999999) && validText(data.foodName, 200) &&\n             validText(data.category, 50) && data.isFavorite is bool && validUpdatedAt(data);\n    }\n\n    match /users/{userId} {\n      allow read, delete: if isOwner(userId);\n      allow create: if isOwner(userId) && isValidUser(request.resource.data, userId);\n      allow update: if isOwner(userId) && uidNotModified(request.resource.data, userId) &&\n        (isValidUser(request.resource.data, userId) ||\n         (request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n           'targetCalories', 'targetProteinGrams', 'targetCarbsGrams', 'targetFatGrams', 'targetWaterMl', 'updatedAt'\n         ]) &&\n          validNumber(request.resource.data.targetCalories, 500, 10000) &&\n          validNumber(request.resource.data.targetProteinGrams, 0, 1000) &&\n          validNumber(request.resource.data.targetCarbsGrams, 0, 2000) &&\n          validNumber(request.resource.data.targetFatGrams, 0, 1000) &&\n          validNumber(request.resource.data.targetWaterMl, 0, 20000) &&\n          validUpdatedAt(request.resource.data)));\n\n      match /favoriteFoods/{foodId} {\n        allow read, delete: if isOwner(userId);\n        allow create: if isOwner(userId) && isValidFavoriteFood(request.resource.data, userId);\n        allow update: if isOwner(userId) && uidNotModified(request.resource.data, userId) && isValidFavoriteFood(request.resource.data, userId);\n      }\n      match /calorieGoals/{goalId} {\n        allow read, delete: if isOwner(userId);\n        allow create: if isOwner(userId) && isValidCalorieGoal(request.resource.data, userId);\n        allow update: if isOwner(userId) && uidNotModified(request.resource.data, userId) && isValidCalorieGoal(request.resource.data, userId);\n      }\n      match /workoutLogs/{workoutLogId} {\n        allow read, delete: if isOwner(userId);\n        allow create: if isOwner(userId) && isValidWorkout(request.resource.data, userId);\n        allow update: if isOwner(userId) && uidNotModified(request.resource.data, userId) && isValidWorkout(request.resource.data, userId);\n      }\n      match /gpsRouteLogs/{logId} {\n        allow read, delete: if isOwner(userId);\n        allow create: if isOwner(userId) && isValidGpsRoute(request.resource.data, userId);\n        allow update: if isOwner(userId) && uidNotModified(request.resource.data, userId) && isValidGpsRoute(request.resource.data, userId);\n      }\n      match /mealPlans/{mealPlanId} {\n        allow read, delete: if isOwner(userId);\n        allow create: if isOwner(userId) && isValidMeal(request.resource.data, userId);\n        allow update: if isOwner(userId) && uidNotModified(request.resource.data, userId) && isValidMeal(request.resource.data, userId);\n      }\n      match /shoppingItems/{itemId} {\n        allow read, delete: if isOwner(userId);\n        allow create: if isOwner(userId) && isValidShoppingItem(request.resource.data, userId);\n        allow update: if isOwner(userId) && uidNotModified(request.resource.data, userId) && isValidShoppingItem(request.resource.data, userId);\n      }\n      match /progressLogs/{logId} {\n        allow read, delete: if isOwner(userId);\n        allow create: if isOwner(userId) && isValidProgress(request.resource.data, userId);\n        allow update: if isOwner(userId) && uidNotModified(request.resource.data, userId) && isValidProgress(request.resource.data, userId);\n      }\n      match /foodRecords/{recordId} {\n        allow read, delete: if isOwner(userId);\n        allow create: if isOwner(userId) && isValidFoodRecord(request.resource.data, userId);\n        allow update: if isOwner(userId) && uidNotModified(request.resource.data, userId) && isValidFoodRecord(request.resource.data, userId);\n      }\n      match /cardioLogs/{logId} {\n        allow read, delete: if isOwner(userId);\n        allow create: if isOwner(userId) && isValidCardio(request.resource.data, userId);\n        allow update: if isOwner(userId) && uidNotModified(request.resource.data, userId) && isValidCardio(request.resource.data, userId);\n      }\n      match /dailyIntake/{dateId} {\n        allow read, delete: if isOwner(userId);\n        allow create: if isOwner(userId) && isValidDailyIntake(request.resource.data, userId);\n        allow update: if isOwner(userId) && uidNotModified(request.resource.data, userId) && isValidDailyIntake(request.resource.data, userId);\n      }\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n"}]}}
